<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CONVERGENCE - Hackathon Edition</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
        }
        body {
            margin: 0;
            padding: 0;
            background: #0d0e15;
            color: #f0f4f8;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
        }
        #game-container {
            position: relative;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            border-radius: 8px;
            overflow: hidden;
            border: 2px solid #3a3f58;
        }
        canvas {
            display: block;
            background: linear-gradient(180deg, #141622 0%, #090a10 100%);
        }
        #ui-layer {
            position: absolute;
            top: 20px;
            left: 20px;
            right: 20px;
            display: flex;
            justify-content: space-between;
            pointer-events: none;
        }
        .ui-box {
            background: rgba(20, 22, 34, 0.85);
            padding: 10px 20px;
            border-radius: 6px;
            border: 1px solid #4a5173;
            font-weight: bold;
            font-size: 18px;
            letter-spacing: 1px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }
        #overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 11, 18, 0.9);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            text-align: center;
            padding: 40px;
        }
        h1 {
            font-size: 42px;
            margin-bottom: 10px;
            color: #00ffcc;
            text-shadow: 0 0 15px rgba(0,255,204,0.4);
            text-transform: uppercase;
            letter-spacing: 3px;
        }
        p {
            font-size: 16px;
            color: #a0a7c4;
            max-width: 500px;
            line-height: 1.6;
            margin-bottom: 30px;
        }
        .btn {
            background: #00ffcc;
            color: #0d0e15;
            border: none;
            padding: 14px 36px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.2s ease;
            box-shadow: 0 0 15px rgba(0,255,204,0.3);
        }
        .btn:hover {
            background: #ffffff;
            box-shadow: 0 0 25px rgba(255,255,255,0.6);
            transform: translateY(-2px);
        }
        .hidden {
            opacity: 0;
            pointer-events: none;
        }
        .controls-hint {
            margin-top: 20px;
            font-size: 13px;
            color: #5f6685;
            border-top: 1px solid #23263a;
            padding-top: 15px;
        }
    </style>
</head>
<body>

    <div id="game-container">
        <canvas id="gameCanvas" width="960" height="540"></canvas>
        
        <div id="ui-layer">
            <div class="ui-box" id="connection-counter">CONNECTED: 0 / 0</div>
            <div class="ui-box" id="level-display">LEVEL 1</div>
        </div>

        <div id="overlay">
            <h1 id="title">CONVERGENCE</h1>
            <p id="description">In a world fragmented by isolation, your touch brings people together. Navigate the terrain, gather lonely souls to build your social chain, and lead them safely back to the Central Node Hub.</p>
            <button class="btn" id="start-btn">Start Connecting</button>
            <div class="controls-hint">
                Controls: <strong>A / D</strong> or <strong>Left / Right Arrows</strong> to Move | <strong>W / Space / Up Arrow</strong> to Jump (Press twice for Double Jump)
            </div>
        </div>
    </div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

// UI Elements
const overlay = document.getElementById('overlay');
const titleText = document.getElementById('title');
const descText = document.getElementById('description');
const startBtn = document.getElementById('start-btn');
const counterUI = document.getElementById('connection-counter');
const levelUI = document.getElementById('level-display');

// Game State Tracking
let gameState = 'START'; 
let currentLevel = 0;
let keys = {};
let lastJumpKeyState = false; // To prevent continuous jump holding from triggering instantly

// Engine Physics Configurations
const PHYSICS = {
    gravity: 0.5,
    friction: 0.85,
};

// Player Object
const player = {
    x: 100,
    y: 300,
    width: 24,
    height: 36,
    vx: 0,
    vy: 0,
    speed: 4.5,
    jumpForce: 11,
    grounded: false,
    jumpsLeft: 2,
    maxJumps: 2,
    color: '#00ffcc'
};

// Map Structures 
const levels = [
    {
        hub: { x: 100, y: 380, width: 50, height: 50 },
        platforms: [
            { x: 0, y: 430, width: 960, height: 110 }, 
            { x: 300, y: 320, width: 160, height: 20 },
            { x: 550, y: 240, width: 200, height: 20 },
            { x: 150, y: 190, width: 120, height: 20 }
        ],
        npcs: [
            { x: 380, y: 290, width: 16, height: 24, connected: false, color: '#ff66b2', name: 'Alice' },
            { x: 650, y: 210, width: 16, height: 24, connected: false, color: '#ffcc66', name: 'Bob' },
            { x: 200, y: 160, width: 16, height: 24, connected: false, color: '#99ff66', name: 'Charlie' }
        ]
    },
    {
        hub: { x: 80, y: 130, width: 50, height: 50 },
        platforms: [
            { x: 0, y: 480, width: 960, height: 60 },   
            { x: 50, y: 180, width: 120, height: 20 },  
            { x: 280, y: 390, width: 150, height: 20 },
            { x: 500, y: 300, width: 150, height: 20 },
            { x: 730, y: 210, width: 180, height: 20 },
            { x: 420, y: 130, width: 160, height: 20 }
        ],
        npcs: [
            { x: 350, y: 360, width: 16, height: 24, connected: false, color: '#a166ff', name: 'David' },
            { x: 570, y: 270, width: 16, height: 24, connected: false, color: '#66ffff', name: 'Emma' },
            { x: 820, y: 180, width: 16, height: 24, connected: false, color: '#ff6666', name: 'Frank' },
            { x: 500, y: 100, width: 16, height: 24, connected: false, color: '#ff66cc', name: 'Grace' }
        ]
    }
];

let platforms = [];
let npcs = [];
let hub = {};
let chainHistory = []; 

// Setup Key Handlers
window.addEventListener('keydown', e => keys[e.code] = true);
window.addEventListener('keyup', e => keys[e.code] = false);

// Button Router
startBtn.addEventListener('click', () => {
    if (gameState === 'START') {
        loadLevel(0);
        gameState = 'PLAYING';
        overlay.classList.add('hidden');
    } else if (gameState === 'LEVEL_CLEAR') {
        currentLevel++;
        if (currentLevel < levels.length) {
            loadLevel(currentLevel);
            gameState = 'PLAYING';
            overlay.classList.add('hidden');
        } else {
            gameState = 'WIN';
            titleText.innerText = "Global Synergy Achieved!";
            descText.innerText = "Incredible work! You successfully bridged all divides, bringing every isolated person into a unified, thriving collective system.";
            startBtn.innerText = "Play Again";
            overlay.classList.remove('hidden');
        }
    } else if (gameState === 'WIN' || gameState === 'GAME_OVER') {
        currentLevel = 0;
        loadLevel(0);
        gameState = 'PLAYING';
        overlay.classList.add('hidden');
    }
});

function loadLevel(idx) {
    const lvl = levels[idx];
    hub = { ...lvl.hub };
    platforms = [ ...lvl.platforms ];
    npcs = lvl.npcs.map(npc => ({ ...npc, connected: false }));
    
    player.x = hub.x + hub.width / 2 - player.width / 2;
    player.y = hub.y;
    player.vx = 0;
    player.vy = 0;
    player.jumpsLeft = player.maxJumps;
    
    chainHistory = [];
    for(let i = 0; i < 200; i++) {
        chainHistory.push({ x: player.x + player.width/2, y: player.y + player.height/2 });
    }
    
    levelUI.innerText = `LEVEL ${idx + 1}`;
    updateUI();
}

function updateUI() {
    const connectedCount = npcs.filter(n => n.connected).length;
    counterUI.innerText = `CONNECTED: ${connectedCount} / ${npcs.length}`;
}

function checkCollision(rect1, rect2) {
    return rect1.x < rect2.x + rect2.width &&
           rect1.x + rect1.width > rect2.x &&
           rect1.y < rect2.y + rect2.height &&
           rect1.y + rect1.height > rect2.y;
}

function update() {
    if (gameState !== 'PLAYING') return;

    // Movement Inputs
    if (keys['KeyA'] || keys['ArrowLeft']) {
        if (player.vx > -player.speed) player.vx--;
    }
    if (keys['KeyD'] || keys['ArrowRight']) {
        if (player.vx < player.speed) player.vx++;
    }

    // Jumping Mechanics (with Double Jump processing edge trigger)
    let jumpKeyPressed = keys['Space'] || keys['KeyW'] || keys['ArrowUp'];
    if (jumpKeyPressed && !lastJumpKeyState) {
        if (player.grounded) {
            player.vy = -player.jumpForce;
            player.grounded = false;
            player.jumpsLeft--;
        } else if (player.jumpsLeft > 0) {
            player.vy = -player.jumpForce * 0.9; // Slightly smaller force for double jump balance
            player.jumpsLeft--;
        }
    }
    lastJumpKeyState = jumpKeyPressed;

    // Apply Physical Attributes
    player.vx *= PHYSICS.friction;
    player.vy += PHYSICS.gravity;

    if (player.x < 0) player.x = 0;
    if (player.x + player.width > canvas.width) player.x = canvas.width - player.width;

    player.x += player.vx;
    platforms.forEach(p => {
        if (checkCollision(player, p)) {
            if (player.vx > 0) player.x = p.x - player.width;
            if (player.vx < 0) player.x = p.x + p.width;
        }
    });

    player.grounded = false;
    player.y += player.vy;
    
    platforms.forEach(p => {
        if (checkCollision(player, p)) {
            if (player.vy > 0) {
                player.y = p.y - player.height;
                player.vy = 0;
                player.grounded = true;
                player.jumpsLeft = player.maxJumps; // Reset jumps upon landing
            }
            else if (player.vy < 0) {
                player.y = p.y + p.height;
                player.vy = 0;
            }
        }
    });

    if (player.y > canvas.height) {
        gameState = 'GAME_OVER';
        titleText.innerText = "Connection Broken";
        descText.innerText = "You fell out of range and lost sync with the group. Don't lose hope—try again!";
        startBtn.innerText = "Retry Level";
        overlay.classList.remove('hidden');
    }

    chainHistory.unshift({ x: player.x + player.width / 2, y: player.y + player.height / 2 });
    if (chainHistory.length > 300) {
        chainHistory.pop();
    }

    npcs.forEach(npc => {
        if (!npc.connected && checkCollision(player, npc)) {
            npc.connected = true;
            updateUI();
        }
    });

    const allConnected = npcs.every(n => n.connected);
    if (allConnected && checkCollision(player, hub)) {
        gameState = 'LEVEL_CLEAR';
        titleText.innerText = "Community United!";
        descText.innerText = `You safely guided all ${npcs.length} individuals to the network node.`;
        startBtn.innerText = currentLevel + 1 < levels.length ? "Proceed to Next Level" : "View Final Report";
        overlay.classList.remove('hidden');
    }
}

function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    ctx.lineWidth = 2;
    ctx.strokeStyle = 'rgba(0, 255, 204, 0.4)';
    ctx.fillStyle = 'rgba(0, 255, 204, 0.15)';
    ctx.beginPath();
    ctx.arc(hub.x + hub.width/2, hub.y + hub.height/2, hub.width/1.2, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    ctx.fillStyle = '#00ffcc';
    ctx.fillRect(hub.x, hub.y, hub.width, hub.height);
    ctx.fillStyle = '#0d0e15';
    ctx.font = '11px sans-serif';
    ctx.fillText("HUB", hub.x + 14, hub.y + 30);

    ctx.fillStyle = '#2a2e45';
    platforms.forEach(p => {
        ctx.fillRect(p.x, p.y, p.width, p.height);
        ctx.fillStyle = '#4a5173';
        ctx.fillRect(p.x, p.y, p.width, 3);
        ctx.fillStyle = '#2a2e45';
    });

    let followIndices = [12, 26, 40, 54, 68]; 
    let activeNpcIndex = 0;

    npcs.forEach((npc) => {
        if (npc.connected) {
            let historyIndex = followIndices[activeNpcIndex] || (followIndices[followIndices.length - 1] + 14);
            let targetPoint = chainHistory[historyIndex] || chainHistory[chainHistory.length - 1];

            npc.x = targetPoint.x - npc.width / 2;
            npc.y = targetPoint.y - npc.height / 2;

            ctx.beginPath();
            ctx.lineWidth = 3;
            ctx.strokeStyle = npc.color;
            
            if (activeNpcIndex === 0) {
                ctx.moveTo(player.x + player.width/2, player.y + player.height/2);
            } else {
                let prevIdx = followIndices[activeNpcIndex - 1];
                let prevPoint = chainHistory[prevIdx] || chainHistory[chainHistory.length - 1];
                ctx.moveTo(prevPoint.x, prevPoint.y);
            }
            
            ctx.lineTo(targetPoint.x, targetPoint.y);
            ctx.stroke();
            activeNpcIndex++;
        }
    });

    npcs.forEach(npc => {
        ctx.fillStyle = npc.color;
        ctx.fillRect(npc.x, npc.y, npc.width, npc.height);

        if (!npc.connected) {
            ctx.strokeStyle = npc.color;
            ctx.lineWidth = 1;
            ctx.beginPath();
            let pulseSize = 12 + Math.sin(Date.now() / 150) * 4;
            ctx.arc(npc.x + npc.width/2, npc.y + npc.height/2, pulseSize, 0, Math.PI*2);
            ctx.stroke();
            
            ctx.fillStyle = 'rgba(255,255,255,0.7)';
            ctx.font = '10px Arial';
            ctx.fillText("?", npc.x + 4, npc.y - 6);
        }
    });

    ctx.fillStyle = player.color;
    ctx.fillRect(player.x, player.y, player.width, player.height);
    
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(player.x + (player.vx >= 0 ? 14 : 4), player.y + 8, 6, 6);
}

function gameLoop() {
    update();
    draw();
    requestAnimationFrame(gameLoop);
}

gameLoop();
</script>
</body>
</html>
